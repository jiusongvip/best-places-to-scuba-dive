---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object;
  breadcrumbs?: { name: string; url?: string }[];
  heroImage?: string;
}

const { title, description, image, schema, breadcrumbs, heroImage } = Astro.props;
const lastUpdated = "2026-08-03";
const canonical = Astro.url.pathname === '/'
  ? new URL('/', Astro.site).toString().replace(/\/$/, '')
  : new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image || "https://www.best-places-to-scuba-dive.com/og-default.png";
const siteUrl = "https://www.best-places-to-scuba-dive.com";

const pageSchema = {
  "@type": "WebPage",
  "@id": canonical,
  "url": canonical,
  "name": title,
  "description": description,
  "inLanguage": "en",
  "datePublished": "2026-01-05",
  "dateModified": lastUpdated,
  "author": { "@type": "Organization", "name": "DiveAtlas Editorial Team", "url": siteUrl + "/about/", "sameAs": ["https://github.com/jiusongvip/best-places-to-scuba-dive"] },
  "publisher": { "@type": "Organization", "name": "DiveAtlas", "url": siteUrl, "logo": { "@type": "ImageObject", "url": siteUrl + "/og-default.png" } },
  "isPartOf": { "@type": "WebSite", "@id": siteUrl + "/#website", "url": siteUrl, "name": "DiveAtlas" },
};

const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    ...(b.url ? { item: new URL(b.url, Astro.site).toString() } : {}),
  })),
} : null;
---

<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) - deferred until first interaction or 4s to reduce main-thread blocking -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4TP031VK73');
    var __gaLoaded = false;
    var __loadGA = function(){
      if (__gaLoaded) return;
      __gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-4TP031VK73';
      document.head.appendChild(s);
    };
    ['pointerdown','keydown','touchstart','scroll'].forEach(function(ev){
      window.addEventListener(ev, __loadGA, { once: true, passive: true });
    });
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | DiveAtlas</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
  <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-400.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-serif-display-400.woff2" crossorigin />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="DiveAtlas" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="revised" content={`${lastUpdated}T00:00:00+08:00`} />
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@graph":[
    {"@type":"Organization","@id":"https://www.best-places-to-scuba-dive.com/#organization","name":"DiveAtlas","url":"https://www.best-places-to-scuba-dive.com","logo":"https://www.best-places-to-scuba-dive.com/og-default.png","description":"The dive destination directory. Find, compare, and discover scuba diving destinations worldwide.","sameAs":["https://github.com/jiusongvip/best-places-to-scuba-dive"]},
    {"@type":"WebSite","@id":"https://www.best-places-to-scuba-dive.com/#website","name":"DiveAtlas","url":"https://www.best-places-to-scuba-dive.com","description":"The dive destination directory.","inLanguage":"en","publisher":{"@id":"https://www.best-places-to-scuba-dive.com/#organization"},"dateModified":lastUpdated}
  ]})}></script>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
  {!['/', '/contact/', '/privacy/', '/terms/'].includes(Astro.url.pathname) && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>}
</head>
<body class="min-h-screen bg-surface text-navy-950 antialiased">
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="organic-blob organic-blob-1" style="width:600px;height:600px;top:-200px;right:-150px;"></div>
    <div class="organic-blob organic-blob-2" style="width:400px;height:400px;bottom:10%;left:-100px;"></div>
    <div class="organic-blob organic-blob-3" style="width:500px;height:500px;bottom:-150px;right:-200px;"></div>
  </div>
  <slot />
  {Astro.url.pathname !== '/' && (
    <div class="relative z-10 bg-white/80 border-t border-sand-200">
      <div class="container-page py-5 text-sm text-navy-600">
        Researched and written by the <a href="/about/" class="font-semibold text-navy-900 hover:text-coral-500 transition-colors">DiveAtlas Editorial Team</a> &middot; Updated {lastUpdated}
      </div>
    </div>
  )}
  <footer class="mt-auto bg-navy-950 text-sand-300">
    <div class="container-page py-14">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-10">
        <div>
          <p class="text-sm font-semibold text-white mb-4">Browse</p>
          <ul class="space-y-2.5">
            <li><a href="/browse/ocean/pacific/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Ocean</a></li>
            <li><a href="/browse/experience/beginner/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Experience</a></li>
            <li><a href="/browse/marine-life/sharks/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Marine Life</a></li>
            <li><a href="/browse/price/budget/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Budget</a></li>
            <li><a href="/browse/month/1/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Month</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-white mb-4">Collections</p>
          <ul class="space-y-2.5">
            <li><a href="/collections/best-shark-diving/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Shark Diving</a></li>
            <li><a href="/collections/best-wreck-diving/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Wreck Diving</a></li>
            <li><a href="/collections/best-macro-diving/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Macro Diving</a></li>
            <li><a href="/collections/best-beginner/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best for Beginners</a></li>
            <li><a href="/collections/best-liveaboard/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Liveaboards</a></li>
            <li><a href="/collections/best-budget/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Budget</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-white mb-4">Tools</p>
          <ul class="space-y-2.5">
            <li><a href="/finder/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Destination Finder</a></li>
            <li><a href="/compare/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Compare Destinations</a></li>
            <li><a href="/map/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">World Map</a></li>
            <li><a href="/about/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">About DiveAtlas</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-white mb-4">Legal</p>
          <ul class="space-y-2.5">
            <li><a href="/contact/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Contact</a></li>
            <li><a href="/privacy/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms/" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Terms of Use</a></li>
          </ul>
        </div>
        <div>
          <a href="/" class="text-xl font-semibold text-white tracking-tight inline-flex items-center gap-1.5 mb-4">
            <span class="w-2 h-2 rounded-full bg-coral-400 inline-block"></span>
            DiveAtlas
          </a>
          <p class="text-sm text-sand-300/70 leading-relaxed">The dive destination directory. Compare 27 scuba diving destinations by visibility, marine life, budget, and season.</p>
        </div>
      </div>
      <div class="mt-12 pt-6 border-t border-navy-700 text-sm text-sand-400/60 flex flex-col sm:flex-row sm:justify-between gap-4">
        <span>&copy; 2026 DiveAtlas. Updated: {lastUpdated}. Not affiliated with PADI, SSI, or any certification agency.</span>
        <div class="flex gap-6">
          <a href="/about/" class="hover:text-coral-400 transition-colors text-sand-400/60">About</a>
          <a href="/contact/" class="hover:text-coral-400 transition-colors text-sand-400/60">Contact</a>
          <a href="/privacy/" class="hover:text-coral-400 transition-colors text-sand-400/60">Privacy</a>
          <a href="/terms/" class="hover:text-coral-400 transition-colors text-sand-400/60">Terms</a>
          <a href="/compare/" class="hover:text-coral-400 transition-colors text-sand-400/60">Compare</a>
          <a href="/finder/" class="hover:text-coral-400 transition-colors text-sand-400/60">Finder</a>
          <a href="/map/" class="hover:text-coral-400 transition-colors text-sand-400/60">Map</a>
        </div>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
    });
  </script>
</body>
</html>
