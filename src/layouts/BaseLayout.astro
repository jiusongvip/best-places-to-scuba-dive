---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object;
  breadcrumbs?: { name: string; url?: string }[];
}

const { title, description, image, schema, breadcrumbs } = Astro.props;
const lastUpdated = "2026-08-03";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image || "https://best-places-to-scuba-dive.com/og-default.png";

const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    ...(b.url ? { item: new URL(b.url, Astro.site).toString() } : {}),
  })),
} : null;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | DiveAtlas</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="DiveAtlas" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="revised" content={`${lastUpdated}T00:00:00+08:00`} />
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","name":"DiveAtlas","url":"https://best-places-to-scuba-dive.com","description":"The dive destination directory.","dateModified":lastUpdated})}></script>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
</head>
<body class="min-h-screen bg-surface text-navy-950 antialiased">
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="organic-blob organic-blob-1" style="width:600px;height:600px;top:-200px;right:-150px;"></div>
    <div class="organic-blob organic-blob-2" style="width:400px;height:400px;bottom:10%;left:-100px;"></div>
    <div class="organic-blob organic-blob-3" style="width:500px;height:500px;bottom:-150px;right:-200px;"></div>
  </div>
  <slot />
  <footer class="mt-auto bg-navy-950 text-sand-300">
    <div class="container-page py-14">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
        <div>
          <h4 class="text-sm font-semibold text-white mb-4">Browse</h4>
          <ul class="space-y-2.5">
            <li><a href="/browse/ocean/pacific" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Ocean</a></li>
            <li><a href="/browse/experience/beginner" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Experience</a></li>
            <li><a href="/browse/marine-life/sharks" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Marine Life</a></li>
            <li><a href="/browse/price/budget" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Budget</a></li>
            <li><a href="/browse/month/1" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">By Month</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white mb-4">Collections</h4>
          <ul class="space-y-2.5">
            <li><a href="/collections/best-shark-diving" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Shark Diving</a></li>
            <li><a href="/collections/best-wreck-diving" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Wreck Diving</a></li>
            <li><a href="/collections/best-macro-diving" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Macro Diving</a></li>
            <li><a href="/collections/best-beginner" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best for Beginners</a></li>
            <li><a href="/collections/best-liveaboard" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Liveaboards</a></li>
            <li><a href="/collections/best-budget" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Best Budget</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white mb-4">Tools</h4>
          <ul class="space-y-2.5">
            <li><a href="/finder" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Destination Finder</a></li>
            <li><a href="/compare" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">Compare Destinations</a></li>
            <li><a href="/map" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">World Map</a></li>
            <li><a href="/about" class="text-sm text-sand-300/70 hover:text-coral-400 transition-colors">About DiveAtlas</a></li>
          </ul>
        </div>
        <div>
          <a href="/" class="text-xl font-semibold text-white tracking-tight inline-flex items-center gap-1.5 mb-4">
            <span class="w-2 h-2 rounded-full bg-coral-400 inline-block"></span>
            DiveAtlas
          </a>
          <p class="text-sm text-sand-300/70 leading-relaxed">The dive destination directory. Compare 300+ scuba diving destinations by visibility, marine life, budget, and season.</p>
        </div>
      </div>
      <div class="mt-12 pt-6 border-t border-navy-700 text-sm text-sand-400/60 flex flex-col sm:flex-row sm:justify-between gap-4">
        <span>&copy; 2026 DiveAtlas. Updated: {lastUpdated}. Not affiliated with PADI, SSI, or any certification agency.</span>
        <div class="flex gap-6">
          <a href="/about" class="hover:text-coral-400 transition-colors text-sand-400/60">About</a>
          <a href="/compare" class="hover:text-coral-400 transition-colors text-sand-400/60">Compare</a>
          <a href="/finder" class="hover:text-coral-400 transition-colors text-sand-400/60">Finder</a>
          <a href="/map" class="hover:text-coral-400 transition-colors text-sand-400/60">Map</a>
        </div>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
    });
  </script>
</body>
</html>
