---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return ['beginner','intermediate','advanced','technical','liveaboard'].map((e: string) => ({ params: { exp: e } }));
}

const { exp } = Astro.params;
const allDests = await getCollection('destinations');
const labelMap: Record<string, string> = { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced', technical: 'Technical', liveaboard: 'Liveaboard' };
const label = labelMap[exp || 'beginner'];
let dests: any[];
if (exp === 'liveaboard') {
  dests = allDests.filter((d: any) => d.data.liveaboardAvailable).sort((a: any, b: any) => b.data.overallRating - a.data.overallRating);
} else {
  dests = allDests.filter((d: any) => d.data.difficulty === exp).sort((a: any, b: any) => b.data.overallRating - a.data.overallRating);
}
const title = 'Best ' + label + ' Scuba Diving Destinations';
const expDescriptions: Record<string, string> = {
  beginner: 'Beginner-friendly dive destinations offer warm water (26°C+), visibility of 20+ meters, gentle to mild currents, and abundant marine life at depths under 18 meters. These sites feature easy shore entries, sandy bottoms, and guided dives with patient instructors. Perfect for newly certified Open Water divers building confidence.',
  intermediate: 'Intermediate destinations cater to divers with 20–50 logged dives who are comfortable with moderate currents, deeper profiles (18–30m), and varied dive types including drift, wall, and night diving. These sites balance excitement with safety, offering richer marine encounters without extreme conditions.',
  advanced: 'Advanced destinations demand 50+ logged dives and often require Advanced Open Water certification. Expect strong currents, deep walls, negative entries, and exposure to pelagics. These are the places where you will find hammerhead schools, whale sharks, and adrenaline-filled drift dives through pristine passes.',
  technical: 'Technical diving destinations push beyond recreational limits with depths exceeding 40 meters, decompression stops, trimix blends, and rebreather profiles. These sites include deep wrecks, blue holes, cave systems, and exploratory dives not accessible to recreational divers.',
  liveaboard: 'Liveaboard diving unlocks remote atolls and pinnacles inaccessible by day boat. Multi-day safaris typically offer 3–4 dives per day, all-inclusive pricing, and access to pristine reefs far from shore-based operations. The best liveaboard destinations combine exclusivity with world-class pelagic encounters.',
};
const expDesc = expDescriptions[exp || 'beginner'];
const avgVis = dests.length > 0 ? Math.round(dests.reduce((s,d) => s + d.data.visibilityMeters, 0) / dests.length) : 0;
const avgRating = dests.length > 0 ? (dests.reduce((s,d) => s + d.data.overallRating, 0) / dests.length).toFixed(1) : 0;
---

<BaseLayout title={title} description={'Compare ' + dests.length + ' top-rated ' + (label || '').toLowerCase() + ' scuba diving destinations by visibility, water temp, marine life, and daily costs. Find your ideal dive trip with DiveAtlas.'} breadcrumbs={[{ name: 'Home', url: '/' }, { name: label }]}>
  <nav class="sticky top-0 z-50 bg-sand-50/90 backdrop-blur border-b border-sand-200">
    <div class="container-page flex items-center justify-between h-16">
      <a href="/" class="text-xl font-semibold text-navy-950 tracking-tight">DiveAtlas</a>
      <div class="text-xs text-navy-500">
        <a href="/" class="hover:text-coral-500 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-navy-700">{label}</span>
      </div>
    </div>
  </nav>
  <section class="bg-navy-950 py-16 md:py-24">
    <div class="container-page">
      <h1 class="text-4xl md:text-5xl font-semibold text-white tracking-tight mb-4">{title}</h1>
      <p class="text-lg text-sand-200/80">{dests.length} destinations for {(label || '').toLowerCase()} divers</p>
    </div>
  </section>
  <section class="py-16">
    <div class="container-page max-w-3xl">
      {expDesc && <p class="text-navy-700 leading-relaxed mb-8">{expDesc}</p>}
      {dests.length > 0 && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
          <div class="bg-coral-50 border border-coral-200 rounded-xl p-4 text-center">
            <p class="text-2xl font-semibold text-coral-600">{dests.length}</p>
            <p class="text-xs text-coral-700 mt-1">Destinations</p>
          </div>
          <div class="bg-coral-50 border border-coral-200 rounded-xl p-4 text-center">
            <p class="text-2xl font-semibold text-coral-600">{avgVis}m</p>
            <p class="text-xs text-coral-700 mt-1">Avg Visibility</p>
          </div>
        </div>
      )}
      <h2 class="text-xl font-semibold text-navy-950 mb-6">Top {label} Dive Destinations</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {dests.map((d: any) => {
          const dd = d.data;
          return (
            <a href={'/destinations/' + dd.slug} class="group block bg-white border border-sand-200 hover:border-ocean-300 rounded-xl overflow-hidden transition-all">
              <div class="aspect-[3/2] bg-sand-200 overflow-hidden">
                <img src={dd.imageLocal} alt={dd.name + ' scuba diving'} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" width="1672" height="941" loading="eager" />
              </div>
              <div class="p-6">
              <h3 class="text-lg font-semibold text-navy-900 group-hover:text-coral-600">{dd.name}</h3>
              <p class="text-sm text-navy-600 mt-2">{dd.country} - {dd.overallRating}/5</p>
              </div>
            </a>
          );
        })}
      </div>
      </div>
    </div>
  </section>
</BaseLayout>