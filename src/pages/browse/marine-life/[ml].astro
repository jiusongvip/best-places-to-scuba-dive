---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return ['sharks','manta-rays','whale-sharks','turtles','coral-reefs','macro'].map((m: string) => ({ params: { ml: m } }));
}

const { ml } = Astro.params;
const allDests = await getCollection('destinations');
const keyMap: Record<string, string> = { sharks: 'sharks', 'manta-rays': 'mantaRays', 'whale-sharks': 'whaleSharks', turtles: 'turtles', 'coral-reefs': 'coral', macro: 'macro' };
const labelMap: Record<string, string> = { sharks: 'Sharks', 'manta-rays': 'Manta Rays', 'whale-sharks': 'Whale Sharks', turtles: 'Turtles', 'coral-reefs': 'Coral Reefs', macro: 'Macro Life' };
const key = keyMap[ml || 'sharks'];
const dests = allDests.filter((d: any) => { const val = (d.data.marineLife as any)[key]; return val && val >= 4; }).sort((a: any, b: any) => { const va = (a.data.marineLife as any)[key]; const vb = (b.data.marineLife as any)[key]; return vb - va; });
const label = labelMap[ml || 'sharks'];
const title = 'Best Scuba Diving for ' + label;
const mlDescriptions: Record<string, string> = {
  sharks: 'Few experiences rival the adrenaline of meeting a shark on its own terms. From schooling hammerheads at Cocos Island to tiger sharks in the Bahamas, these destinations offer the world\'s most reliable shark encounters. Every site listed here scores 4+ out of 5 for shark abundance based on community reports.',
  'manta-rays': 'Manta rays, with wingspans reaching 7 meters, are among the ocean\'s most graceful giants. These destinations feature reliable manta cleaning stations, seasonal aggregations of hundreds of individuals, and night dives where mantas feed on plankton attracted by dive lights.',
  'whale-sharks': 'The world\'s largest fish can reach 12 meters in length. These gentle filter-feeders aggregate seasonally at specific sites, offering divers the chance to swim alongside them. Our top-rated destinations score 4+ for whale shark encounters.',
  turtles: 'Sea turtles have patrolled the oceans for over 100 million years. These destinations offer exceptional turtle encounters — from nesting beaches with thousands of green turtles to dive sites where hawksbills and loggerheads are guaranteed sightings.',
  'coral-reefs': 'Coral reefs cover less than 1% of the ocean floor but support 25% of all marine life. These destinations are rated 4+ for coral diversity and health, featuring everything from shallow fringing reefs to dramatic walls draped in soft corals and sea fans.',
  macro: 'Macro diving reveals the ocean\'s smallest, strangest inhabitants. Pygmy seahorses smaller than a fingernail, flamboyant cuttlefish, blue-ringed octopus, and harlequin shrimp. These muck diving capitals are rated 4+ for critter density and diversity.',
};
const mlDesc = mlDescriptions[ml || 'sharks'];
const avgRating = dests.length > 0 ? (dests.reduce((s,d) => s + d.data.overallRating, 0) / dests.length).toFixed(1) : 0;
const avgVis = dests.length > 0 ? Math.round(dests.reduce((s,d) => s + d.data.visibilityMeters, 0) / dests.length) : 0;
const avgTemp = dests.length > 0 ? Math.round(dests.reduce((s,d) => s + d.data.waterTempCelsius, 0) / dests.length) : 0;
const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const fmtMonths = (ms: number[]) => ms.map((m: number) => monthNames[m - 1]).join(', ');
const faqs: Record<string, { q: string; a: string }[]> = {
  sharks: [
    { q: 'Where can I reliably see sharks while diving?', a: `Our ${dests.length} rated destinations cover the full shark spectrum: schooling hammerheads in the Galapagos and Cocos Island, tiger sharks in the Bahamas, and grey reef sharks on almost every Pacific reef. The most reliable encounters combine deep drop-offs with strong currents - exactly the sites rated 4+ in this collection.` },
    { q: 'Is shark diving dangerous?', a: 'Shark diving is one of the safest adventure sports when done with professional operators. The species divers encounter - reef sharks, hammerheads, whale sharks - are not man-eaters. Guides brief proper behaviour: stay in your group, avoid surface splashing, and never chase. Millions of shark dives happen annually with extremely rare incidents.' },
    { q: 'When is the best season for shark encounters?', a: `Shark season varies by species and location. Hammerhead schooling peaks June to December in the Galapagos; tiger sharks are year-round in the Bahamas with a winter peak; reef sharks are reliable all year across the Pacific. Average conditions across this collection: ${avgVis}m visibility, ${avgTemp}°C water.` },
    { q: 'What certification do I need for shark dives?', a: `Most shark sites require Advanced Open Water, and remote liveaboard routes often demand 50+ logged dives. Some shark encounters - like the Bahamas' tiger shark dives - are open to Open Water divers with a guide. Always confirm requirements with the operator before booking.` },
  ],
  'manta-rays': [
    { q: 'Where are manta rays most reliable?', a: `The Maldives' Hanifaru Bay hosts the world's largest manta aggregation - over 100 individuals during plankton season. Kona in Hawaii and Yap in Micronesia offer year-round cleaning stations, while Raja Ampat delivers mantas on almost every dive at the right current. Our top destinations all score 4+ for manta reliability.` },
    { q: 'What is a manta cleaning station?', a: 'Cleaning stations are shallow rocky outcrops where cleaner wrasse remove parasites from mantas. Mantas queue up in a choreographed circuit, allowing divers to watch them hover and glide just meters away. The Maldives, Rangiroa, and Palau all offer world-class cleaning station dives.' },
    { q: 'When is manta season?', a: `Manta encounters peak during plankton blooms: June to November in the Maldives, December to April in Kona, and year-round with seasonal peaks in Raja Ampat. Water averages ${avgTemp}°C and visibility ${avgVis}m across this collection, with manta dives usually scheduled around current and tide tables.` },
    { q: 'Can beginners dive with mantas?', a: 'Yes - most manta sites are gentle, shallow dives. Hanifaru Bay is a protected site with strict rules: no chasing, no touching, and neutral buoyancy required. A buoyancy refresher before your trip is worth it, since manta encounters are brief and you want to be calm and steady when they arrive.' },
  ],
  'whale-sharks': [
    { q: 'How big do whale sharks get?', a: 'Whale sharks are the largest fish on Earth, reaching 12 meters and 20 tonnes. Despite their size, they are filter feeders that eat only plankton, making them completely safe to swim alongside. Juveniles (5-8 meters) are the most common sighting at most aggregation sites.' },
    { q: 'Where are whale shark encounters most reliable?', a: `Only ${dests.length} destinations in our database score 4+ for whale sharks, reflecting how seasonal and unpredictable these giants are. The Maldives and Rangiroa are our top-rated sites, with seasonal aggregations that local guides track daily. Mexico's Isla Mujeres and the Philippines' Donsol also offer famous (if less consistent) encounters.` },
    { q: 'When is whale shark season?', a: `Whale sharks follow plankton blooms, so timing is everything. The Maldives peaks May to December; Rangiroa is best August to October; Donsol runs November to June. Book with operators who refund or reschedule when conditions fail - even in peak season, no operator can guarantee a sighting.` },
    { q: 'Do I need special skills for whale shark swimming?', a: 'Many whale shark encounters happen while snorkeling, which requires no certification. If you dive, Open Water is sufficient - encounters are usually in 5-15 meters of water. The critical skill is finning technique: strong, slow kicks that let you keep pace without exhausting yourself or stressing the shark.' },
  ],
  turtles: [
    { q: 'Where can I see turtles on every dive?', a: `The Maldives and Sipadan are famous for turtle density - green turtles grazing on reef flats and hawksbills on walls are daily sightings. Our ${dests.length} rated destinations all deliver consistent turtle encounters, with Sipadan's Barracuda Point and the Maldives' house reefs among the most reliable spots on Earth.` },
    { q: 'Which turtle species will I see?', a: 'Green turtles are the most common, followed by hawksbills with their distinctive overlapping shell plates. Loggerheads appear at temperate sites, and leatherbacks pass through oceanic routes. Hawksbill and green turtle populations have recovered strongly in marine protected areas, which is why these destinations rate 4+.' },
    { q: 'When is nesting season?', a: `Turtle nesting peaks May to October across the tropics, but dive encounters are year-round - turtles live and feed on reefs all year. Water temperatures average ${avgTemp}°C with ${avgVis}m visibility across this collection, and night dives often reveal sleeping turtles tucked under ledges.` },
    { q: 'How should I behave around turtles?', a: 'Turtles are protected everywhere in this collection. Keep 3+ meters distance, never block their ascent to the surface, and never touch - the waxy coating on their shells is sensitive. Photography is best from a stationary position: turtles cruise predictable paths and will often pass close to a calm diver.' },
  ],
  'coral-reefs': [
    { q: 'What makes a coral reef rate 4+?', a: `Our coral scores combine hard coral cover, diversity (100+ species), health (minimal bleaching), and fish density. The Coral Triangle destinations - Raja Ampat, Kimbe Bay, Tubbataha - hold 75% of the world's coral species, while Fiji and the Red Sea contribute exceptional reef structure and colour.` },
    { q: 'Which destination has the best corals?', a: `Raja Ampat is the undisputed leader with 600+ coral species and 1,500+ fish species. Tubbataha Reefs Natural Park offers pristine, protected walls untouched by coastal development, and Kimbe Bay in Papua New Guinea holds the world's highest coral diversity per square meter.` },
    { q: 'How does climate change affect these reefs?', a: 'Bleaching events are real, but the reefs in this collection sit mostly in current-rich, deep-water zones that recover faster and stay cooler than coastal reefs. Marine protected areas like Tubbataha and Raja Ampat enforce no-take rules that keep ecosystems resilient. Dive operators also support reef restoration at several sites.' },
    { q: 'When should I visit for the healthiest corals?', a: `Corals are healthiest during and just after the cool season, when bleaching risk is lowest: December to April across the tropics. Visibility averages ${avgVis}m and water temperature ${avgTemp}°C in this collection. Avoid El Niño summers when sea surface temperatures spike.` },
  ],
  macro: [
    { q: 'What is muck diving?', a: `Muck diving explores volcanic sand slopes and artificial structures where bizarre critters gather: flamboyant cuttlefish, mimic octopus, harlequin shrimp, frogfish, and pygmy seahorses. Indonesia's Lembeh Strait and Anilao are the world capitals of muck, with densities unmatched anywhere else.` },
    { q: 'Do I need special equipment for macro photography?', a: 'A camera with macro mode or a wet/dioptre lens is essential, plus a focus light and patience. Beginners should consider a dive guide who can spot critters - guides in Lembeh and Anilao routinely find 20+ species per dive. A 100mm equivalent lens is the sweet spot for most subjects.' },
    { q: 'When is the best time for macro diving?', a: `Macro diving is surprisingly seasonal: calm, still water is best for spotting tiny subjects. November to April delivers the calmest conditions across our macro destinations, with ${avgVis}m visibility and ${avgTemp}°C water. Night dives are excellent - many critters only emerge after dark.` },
    { q: 'Is macro diving suitable for beginners?', a: 'Yes - muck sites are shallow (5-20 meters) with little current, ideal for new divers. The challenge is buoyancy control for photography. We recommend 20+ dives and a buoyancy specialty before a photo-focused trip, since hovering inches above sand without stirring it takes practice.' },
  ],
};
const faqList = faqs[ml || 'sharks'] || [];
const topDests = dests.slice(0, 10);
const links: { href: string; label: string }[] = {
  sharks: [{ href: '/collections/best-shark-diving', label: 'Best shark diving collection' }, { href: '/browse/experience/advanced', label: 'Advanced destinations' }, { href: '/browse/ocean/pacific', label: 'Pacific Ocean diving' }, { href: '/compare', label: 'Compare destinations' }, { href: '/map', label: 'Explore the dive map' }, { href: '/browse/experience/liveaboard', label: 'Liveaboard trips' }],
  'manta-rays': [{ href: '/collections/best-liveaboard', label: 'Liveaboard trips' }, { href: '/browse/ocean/indian', label: 'Indian Ocean diving' }, { href: '/browse/experience/beginner', label: 'Beginner destinations' }, { href: '/compare', label: 'Compare destinations' }, { href: '/map', label: 'Explore the dive map' }, { href: '/browse/marine-life/sharks', label: 'Shark diving' }],
  'whale-sharks': [{ href: '/browse/ocean/indian', label: 'Indian Ocean diving' }, { href: '/browse/experience/beginner', label: 'Beginner destinations' }, { href: '/browse/marine-life/manta-rays', label: 'Manta ray diving' }, { href: '/compare', label: 'Compare destinations' }, { href: '/map', label: 'Explore the dive map' }, { href: '/collections/best-liveaboard', label: 'Liveaboard trips' }],
  turtles: [{ href: '/browse/marine-life/coral-reefs', label: 'Coral reef diving' }, { href: '/browse/experience/beginner', label: 'Beginner destinations' }, { href: '/browse/ocean/caribbean', label: 'Caribbean diving' }, { href: '/compare', label: 'Compare destinations' }, { href: '/map', label: 'Explore the dive map' }, { href: '/browse/price/mid-range', label: 'Mid-range diving' }],
  'coral-reefs': [{ href: '/browse/marine-life/macro', label: 'Macro diving' }, { href: '/browse/ocean/pacific', label: 'Pacific Ocean diving' }, { href: '/browse/experience/beginner', label: 'Beginner destinations' }, { href: '/compare', label: 'Compare destinations' }, { href: '/map', label: 'Explore the dive map' }, { href: '/collections/best-liveaboard', label: 'Liveaboard trips' }],
  macro: [{ href: '/collections/best-macro-diving', label: 'Best macro collection' }, { href: '/browse/ocean/pacific', label: 'Pacific Ocean diving' }, { href: '/browse/price/budget', label: 'Budget diving' }, { href: '/compare', label: 'Compare destinations' }, { href: '/map', label: 'Explore the dive map' }, { href: '/browse/marine-life/coral-reefs', label: 'Coral reef diving' }],
}[ml || 'sharks'] || [];
---

<BaseLayout title={title} description={'Compare ' + dests.length + ' top-rated scuba diving destinations for ' + (label || '').toLowerCase() + ' by visibility, season, water temp, and difficulty. Plan your dive trip with DiveAtlas.'} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Marine Life' }, { name: label }]}>
  <nav class="sticky top-0 z-50 bg-surface/90 backdrop-blur border-b border-border">
    <div class="container-page flex items-center justify-between h-16">
      <a href="/" class="text-xl font-semibold text-navy-950 tracking-tight">DiveAtlas</a>
      <div class="text-xs text-navy-500">
        <a href="/" class="hover:text-coral-500 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-navy-700">Marine Life / {label}</span>
      </div>
    </div>
  </nav>
  <section class="bg-navy-950 py-16 md:py-24">
    <div class="container-page">
      <h1 class="text-4xl md:text-5xl font-semibold text-white tracking-tight mb-4">{title}</h1>
      <p class="text-lg text-sand-200/80">{dests.length} destinations rated 4+ for {(label || '').toLowerCase()}</p>
    </div>
  </section>
  <section class="py-16">
    <div class="container-page max-w-3xl">
      {mlDesc && <p class="text-navy-700 leading-relaxed mb-8">{mlDesc}</p>}
      <h2 class="text-xl font-semibold text-navy-950 mb-6">Best Destinations for {label} ({dests.length} rated 4+)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {dests.map((d: any) => {
          const dd = d.data;
          return (
            <a href={'/destinations/' + dd.slug} class="group block bg-white border border-sand-200 hover:border-ocean-300 rounded-xl overflow-hidden transition-all">
              <div class="aspect-[3/2] bg-sand-200 overflow-hidden">
                <img src={dd.imageLocal} alt={dd.name + ' scuba diving'} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" width="1672" height="941" loading="eager" />
              </div>
              <div class="p-6">
              <h3 class="text-lg font-semibold text-navy-900 group-hover:text-coral-600">{dd.name}</h3>
              <p class="text-sm text-navy-600 mt-2">{dd.country} - {((dd.marineLife as any)[key] || 0)}/5 {(label || '').toLowerCase()}</p>
              </div>
            </a>
          );
        })}
      </div>

      {topDests.length > 0 && (
        <div class="mt-16">
          <h2 class="text-2xl font-semibold text-navy-950 mb-2">The Top {label} Experiences in Detail</h2>
          <p class="text-navy-600 mb-8">Why these destinations earned a 4+ score for {(label || '').toLowerCase()}, combining community ratings with our editorial research.</p>
          <div class="space-y-6 mb-12">
            {topDests.map((d: any) => {
              const dd = d.data;
              const topSpots = (dd.bestDiveSpots || []).slice(0, 2).map((s: any) => s.name).join(' and ');
              const score = (dd.marineLife as any)[key] || 0;
              return (
                <div class="bg-white border border-sand-200 rounded-xl p-6">
                  <h3 class="font-semibold text-navy-900 mb-2"><a href={'/destinations/' + dd.slug} class="hover:text-coral-600">{dd.name}</a>, {dd.country} - {score}/5 {(label || '').toLowerCase()}</h3>
                  <p class="text-sm text-navy-600 leading-relaxed mb-2">{dd.tagline}.</p>
                  <p class="text-sm text-navy-600 leading-relaxed">Rated {dd.overallRating}/5 overall with {dd.visibilityMeters}m visibility and {dd.waterTempCelsius}&deg;C water, {dd.name} is best dived from {fmtMonths(dd.bestMonths)}. The signature sites for {(label || '').toLowerCase()} are {topSpots}. Its {dd.difficulty} difficulty profile and {dd.budgetLevel} pricing tier make it accessible to divers at the right experience level.</p>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {topDests.length > 0 && (
        <div class="mt-12 mb-12">
          <h2 class="text-2xl font-semibold text-navy-950 mb-2">Quick Comparison: {label} Destinations</h2>
          <p class="text-navy-600 mb-6">Side-by-side stats for every destination rated 4+ for {(label || '').toLowerCase()}.</p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left border-collapse">
              <thead>
                <tr class="bg-navy-950 text-white">
                  <th class="px-4 py-3 font-medium">Destination</th>
                  <th class="px-4 py-3 font-medium">{label} score</th>
                  <th class="px-4 py-3 font-medium">Rating</th>
                  <th class="px-4 py-3 font-medium">Visibility</th>
                  <th class="px-4 py-3 font-medium">Temp</th>
                  <th class="px-4 py-3 font-medium">Best months</th>
                  <th class="px-4 py-3 font-medium">Difficulty</th>
                </tr>
              </thead>
              <tbody>
                {topDests.map((d: any, i: number) => {
                  const dd = d.data;
                  return (
                    <tr class={i % 2 === 0 ? 'bg-white' : 'bg-sand-100/60'}>
                      <td class="px-4 py-3 font-medium text-navy-900"><a href={'/destinations/' + dd.slug} class="hover:text-coral-600">{dd.name}</a></td>
                      <td class="px-4 py-3 text-navy-600">{((dd.marineLife as any)[key] || 0)}/5</td>
                      <td class="px-4 py-3 text-navy-600">{dd.overallRating}/5</td>
                      <td class="px-4 py-3 text-navy-600">{dd.visibilityMeters}m</td>
                      <td class="px-4 py-3 text-navy-600">{dd.waterTempCelsius}&deg;C</td>
                      <td class="px-4 py-3 text-navy-600">{fmtMonths(dd.bestMonths)}</td>
                      <td class="px-4 py-3 text-navy-600">{dd.difficulty}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <div class="mt-12 mb-12">
        <h2 class="text-2xl font-semibold text-navy-950 mb-2">Frequently Asked Questions</h2>
        <div class="space-y-6">
          {faqList.map((f: any) => (
            <div class="bg-sand-100/50 border border-sand-200 rounded-xl p-6">
              <h3 class="font-semibold text-navy-900 mb-2">{f.q}</h3>
              <p class="text-sm text-navy-600 leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12">
        <h2 class="text-2xl font-semibold text-navy-950 mb-2">Explore More Marine Life</h2>
        <p class="text-navy-600 mb-6">Browse other species and related dive collections to plan your next trip.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {links.map((l: any) => (
            <a href={l.href} class="bg-white border border-sand-200 hover:border-coral-300 rounded-xl px-4 py-3 text-sm font-medium text-navy-800 hover:text-coral-600 transition-colors">{l.label}</a>
          ))}
        </div>
      </div>
      </div>
    </div>
  </section>
</BaseLayout>