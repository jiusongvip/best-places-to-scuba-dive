---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return ['pacific','indian','caribbean','red-sea','atlantic','mediterranean'].map(o => ({ params: { ocean: o } }));
}

const { ocean } = Astro.params;
const allDests = await getCollection('destinations');
const dests = allDests.filter(d => d.data.ocean === ocean).sort((a,b) => b.data.overallRating - a.data.overallRating);
const label = ocean === 'red-sea' ? 'Red Sea' : ocean.charAt(0).toUpperCase() + ocean.slice(1);
const title = ocean === 'red-sea' ? `Red Sea Scuba Diving` : `Scuba Diving in the ${label} Ocean`;
const regionLabel = ocean === 'red-sea' ? 'Red Sea' : `the ${label} Ocean`;
const description = `Compare ${dests.length} top-rated dive sites in ${regionLabel} by visibility, marine life, water temperature, and season.`;
const avgVis = dests.length > 0 ? Math.round(dests.reduce((s,d) => s + d.data.visibilityMeters, 0) / dests.length) : 0;
const avgRating = dests.length > 0 ? (dests.reduce((s,d) => s + d.data.overallRating, 0) / dests.length).toFixed(1) : 0;
const avgTemp = dests.length > 0 ? Math.round(dests.reduce((s,d) => s + d.data.waterTempCelsius, 0) / dests.length) : 0;
const minCost = dests.length > 0 ? Math.min(...dests.map(d => d.data.averageDailyCostUsd)) : 0;
const maxCost = dests.length > 0 ? Math.max(...dests.map(d => d.data.averageDailyCostUsd)) : 0;
const difficultyLabels: Record<string, string> = { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced', technical: 'Technical' };
const difficultySpread = dests.length > 0 ? [...new Set(dests.map(d => difficultyLabels[d.data.difficulty] || d.data.difficulty))].join(', ') : '';
const oceanDescriptions: Record<string, string> = {
  pacific: 'The Pacific Ocean hosts the Coral Triangle, the most biodiverse marine ecosystem on Earth. Over 1,500 fish species and 75% of the world\'s coral species thrive here, from Raja Ampat\'s kaleidoscopic reefs to Komodo\'s current-swept pinnacles. Divers encounter everything from pygmy seahorses to whale sharks in the richest waters on the planet.',
  indian: 'The Indian Ocean offers some of the world\'s most accessible luxury diving. Crystal-clear atolls, manta ray cleaning stations, and seasonal whale shark aggregations define this region. The Maldives alone has over 1,000 coral islands, each surrounded by thriving house reefs with gentle currents ideal for beginners and photographers.',
  caribbean: 'The Caribbean Sea is the world\'s most accessible dive region, with year-round warm water averaging 27°C, exceptional visibility, and abundant marine life at shallow depths. Shore diving meccas like Bonaire offer 80+ named sites you can walk into from the beach. The Mesoamerican Barrier Reef stretches over 1,000 km from Mexico to Honduras.',
  'red-sea': 'The Red Sea is the wreck diving capital of the world, home to the legendary SS Thistlegorm and over 250 identified shipwrecks. Beyond wrecks, vibrant coral walls plunge to abyssal depths, and Ras Mohammed National Park offers some of the most dramatic drop-offs on Earth. Visibility routinely exceeds 30 meters.',
  atlantic: 'Atlantic diving spans an extraordinary range — from the Azores\' blue shark encounters to Fernando de Noronha\'s spinner dolphin bays. This ocean connects temperate pelagic action with tropical reef systems, offering some of the most diverse diving experiences on the planet.',
  mediterranean: 'The Mediterranean may be less famous than tropical destinations, but its ancient shipwrecks, marine protected areas, and crystal visibility rank among Europe\'s most rewarding dive experiences. Over 150 marine reserves protect Posidonia seagrass meadows that are up to 100,000 years old.',
};
const oceanDesc = oceanDescriptions[ocean || ''] || '';
---

<BaseLayout title={title} description={description} breadcrumbs={[{ name: "Home", url: "/" }, { name: "Oceans" }, { name: label }]}>
  <nav class="sticky top-0 z-50 bg-surface/90 backdrop-blur border-b border-border">
    <div class="container-page flex items-center justify-between h-16">
      <a href="/" class="text-xl font-semibold text-navy-950 tracking-tight">DiveAtlas</a>
      <div class="text-xs text-navy-500">
        <a href="/" class="hover:text-coral-500 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-navy-700">{label} Ocean</span>
      </div>
    </div>
  </nav>
  <section class="bg-navy-950 py-16 md:py-24">
    <div class="container-page">
      <h1 class="text-4xl md:text-5xl font-semibold text-white tracking-tight mb-4">Scuba Diving in the {label} Ocean</h1>
      <p class="text-lg text-sand-200/80 max-w-xl">{dests.length} dive destinations</p>
    </div>
  </section>
  <section class="py-16">
    <div class="container-page max-w-3xl">
      {oceanDesc && (
        <div>
          <p class="text-navy-700 leading-relaxed mb-8">{oceanDesc}</p>
          {dests.length > 0 && (
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
              <div class="bg-ocean-50 border border-ocean-200 rounded-xl p-4 text-center">
                <p class="text-2xl font-semibold text-ocean-600">{dests.length}</p>
                <p class="text-xs text-ocean-700 mt-1">Destinations</p>
              </div>
              <div class="bg-ocean-50 border border-ocean-200 rounded-xl p-4 text-center">
                <p class="text-2xl font-semibold text-ocean-600">{avgVis}m</p>
                <p class="text-xs text-ocean-700 mt-1">Avg Visibility</p>
              </div>
              <div class="bg-ocean-50 border border-ocean-200 rounded-xl p-4 text-center">
                <p class="text-2xl font-semibold text-ocean-600">{avgTemp}&deg;C</p>
                <p class="text-xs text-ocean-700 mt-1">Avg Water Temp</p>
              </div>
              <div class="bg-ocean-50 border border-ocean-200 rounded-xl p-4 text-center">
                <p class="text-2xl font-semibold text-ocean-600">{avgRating}</p>
                <p class="text-xs text-ocean-700 mt-1">Avg Rating</p>
              </div>
            </div>
          )}
        </div>
      )}
      {dests.length === 0 ? (
        <div class="bg-sand-100/50 rounded-xl p-10 text-center">
          <p class="text-navy-500 text-lg mb-2">No destinations yet in the {label} Ocean.</p>
          <p class="text-navy-400 text-sm">We are actively researching dive sites in this region. Check back soon or browse other oceans.</p>
        </div>
      ) : (
        <div>
          <h2 class="text-xl font-semibold text-navy-950 mb-6">Dive Destinations in the {label} Ocean</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {dests.map(d => {
            const dd = d.data;
            return (
              <a href={`/destinations/${dd.slug}`} class="group block bg-white border border-sand-200 hover:border-ocean-300 rounded-xl overflow-hidden transition-all">
                <div class="aspect-[3/2] bg-sand-200 overflow-hidden">
                  <img src={dd.imageLocal} alt={dd.name + ' scuba diving'} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" width="1672" height="941" loading="eager" />
                </div>
                <div class="p-6">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-lg font-semibold text-navy-900 group-hover:text-coral-600 transition-colors">{dd.name}</h3>
                  <span class="text-xs text-amber-500 bg-sand-100 px-2 py-1 rounded font-medium">{dd.overallRating}</span>
                </div>
                <p class="text-sm text-navy-600 leading-relaxed mb-4">{dd.tagline}</p>
                <div class="grid grid-cols-2 gap-2 text-xs text-navy-500">
                  <div>Vis: {dd.visibilityMeters}m</div><div>Temp: {dd.waterTempCelsius}C</div>
                  <div>{dd.difficulty}</div><div>{dd.budgetLevel}</div>
                </div>
                </div>
              </a>
            );
          })}
        </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>