<script type="application/json" id="dest-data" is:inline>{dJson}</script>

<script is:inline>  (function(){    
var el=document.getElementById("dest-data");    if(!el) return;    
var destMap=JSON.parse(el.textContent||"[]");    if(!destMap.length) return;    
var s=document.getElementById("hero-search"), su=document.getElementById("search-suggestions");    if(!s||!su) return;    s.addEventListener("input",function(){      
var q=s.value.toLowerCase().trim();      if(q.length<2){su.classList.add("hidden");return}      
var m=destMap.filter(function(d){return d.name.toLowerCase().indexOf(q)!==-1||d.country.toLowerCase().indexOf(q)!==-1}).slice(0,8);      if(!m.length){su.classList.add("hidden");return}      su.innerHTML=m.map(function(d){return '
<a href="/destinations/'+d.slug+'" class="block px-5 py-3 hover:bg-navy-700 transition-colors border-b border-navy-700 last:border-0"><span class="text-white font-medium">'+d.name+'</span><span class="text-navy-400 text-sm ml-2">'+d.country+'</span></a>'}).join("");      su.classList.remove("hidden")    });    document.addEventListener("click",function(e){if(!s.contains(e.target)&&!su.contains(e.target))su.classList.add("hidden")})  })();</script>

<script is:inline>  (function(){    
var mapSection = document.getElementById("map-section");    if(!mapSection) return;    
var observer = new IntersectionObserver(function(entries){      if(entries[0].isIntersecting){        
var s = document.createElement("script");        s.src = "/map.js";        document.body.appendChild(s);        observer.disconnect();      }    }, {rootMargin: "200px"});    observer.observe(mapSection);  })();</script>
